%Constants and geometry assumptions
esp0 = 8.8542; % F/m
E0 = 100; %V/m
plateSide = 20e-3; %m 
plateGap = 2e-3; %m 
shutterwidth = 20e-3; %m
d = 2e-3; %m 
baseTopY = 2e-3; %mm
senseY = 4e-3; %m 
shutterY = senseY+d; %m
plateDepth = plateSide; %m
shutterVelocity = 20e-3; %m/s
Rf = 100e6; %ohm

%Grid/array Setup
Lx = 80e-3; 
Ly = 40e-3; 
h = 0.25e-3; %dx = dy = h
Nx = round(Lx/h)+1; 
Ny = round(Ly/h)+1; 
x = (0:Nx-1)*h; 
y = (0:Ny-1)*h; 
Lx = x(end); 
Ly = y(end); 
dx = x(2)-x(1); 
dy = y(2)-y(1); 
assert(abs(dx-dy) < 100*esp(max(dx,dy)), 'Grid must satisfy dx = dy.');
[X,Y] = meshgrid(x,y); 

%Add Conductors
xc = Lx/2;
plate1Right = xc-plateGap/2; 
plate1Left = plate1Right-plateSide;
plate2Left = xc+plateGap/2;  
plate2Right = plate2Left+plateSide;
[~,baseRow] = min(abs(y-baseTopY));
[~,senseRow] = min(abs(y-senseY));
[~,shutterRow] = min(abs(y-shutterY));
p1 = x>=plate1Left & x<=plate1Right;
p2 = x>=plate2Left & x<=plate2Right;
shutterCenters = linspace((plate1Left+plate1Right)/2, ...
    (plate2Left+plate2Right)/2,41);
time = (shutterCenters-shutterCenters(1))/shutterVelocity;
Npos = numel(shutterCenters);
 
%Laplace Solver
maxIter = 50000; tol = 1e-7;
Q1=zeros(1,Npos); Q2=Q1; Q1ana=Q1; Q2ana=Q1;
iters=Q1; finalChange=Q1; maxResidual=Q1; conductorError=Q1;
saveIdx=[1 round((Npos+1)/2) Npos];
VnumSave=cell(1,3); VanaSave=cell(1,3); errVSave=cell(1,3);
ExSave=cell(1,3); EySave=cell(1,3); shBounds=zeros(3,2);
 
%Shutter Sweep
for k=1:Npos
    shC=shutterCenters(k); shL=shC-shutterWidth/2; shR=shC+shutterWidth/2;
    sh = x>=shL & x<=shR;
    V = E0*Y;  % initial guess

    fixed=false(Ny,Nx); fixedValue=zeros(Ny,Nx);
    fixed(1:baseRow,:)=true;                       % grounded base
    fixed(senseRow,p1)=true; fixed(senseRow,p2)=true; % virtual grounds
    fixed(shutterRow,sh)=true;                     % grounded shutter
    fixed(end,:)=true; fixedValue(end,:)=E0*Ly;   % applied far field
    V(fixed)=fixedValue(fixed);

    %Numerical Laplace Solution
    for n=1:maxIter
        Vold=V; Vnew=Vold;
        avg4=0.25*(Vold(3:end,2:end-1)+Vold(1:end-2,2:end-1)+ ...
            Vold(2:end-1,3:end)+Vold(2:end-1,1:end-2));
        fInterior=fixed(2:end-1,2:end-1);
        block=Vnew(2:end-1,2:end-1);
        block(~fInterior)=avg4(~fInterior);
        Vnew(2:end-1,2:end-1)=block;
        Vnew(2:end-1,1)=Vnew(2:end-1,2);           % dV/dx=0
        Vnew(2:end-1,end)=Vnew(2:end-1,end-1);     % dV/dx=0
        Vnew(fixed)=fixedValue(fixed);
        change=max(abs(Vnew(:)-Vold(:)));
        V=Vnew;
        if change<tol, break; end
    end
 
Vnumerical=V;
iters(k)=n; finalChange(k)=change;

%Verify Laplace Equation
    lap=zeros(Ny,Nx);
    lap(2:end-1,2:end-1)=(Vnumerical(3:end,2:end-1)+ ...
        Vnumerical(1:end-2,2:end-1)+Vnumerical(2:end-1,3:end)+ ...
        Vnumerical(2:end-1,1:end-2)-4*Vnumerical(2:end-1,2:end-1))/h^2;
    free=false(Ny,Nx); free(2:end-1,2:end-1)=~fixed(2:end-1,2:end-1);
    maxResidual(k)=max(abs(lap(free)));
    conductorError(k)=max(abs(Vnumerical(fixed)-fixedValue(fixed)));
 
%Numerical electric field and charge
    [dVdx,dVdy]=gradient(Vnumerical,h,h);
    Ex=-dVdx; Ey=-dVdy;
    Ey1=-(Vnumerical(senseRow+1,p1)-Vnumerical(senseRow,p1))/h;
    Ey2=-(Vnumerical(senseRow+1,p2)-Vnumerical(senseRow,p2))/h;
    Q1(k)=sum(eps0*Ey1)*h*plateDepth;
    Q2(k)=sum(eps0*Ey2)*h*plateDepth;
 
%Analytical charge solution
    covered1=max(0,min(plate1Right,shR)-max(plate1Left,shL));
    covered2=max(0,min(plate2Right,shR)-max(plate2Left,shL));
    Aexp1=(plateSide-covered1)*plateDepth;
    Aexp2=(plateSide-covered2)*plateDepth;
    Q1ana(k)=-eps0*E0*Aexp1; Q2ana(k)=-eps0*E0*Aexp2;

%Mapped potential to grid
    Vanalytical=zeros(Ny,Nx);
    for j=1:Nx
        if sh(j)
            above=y>shutterY;
            Vanalytical(above,j)=E0*(y(above)-shutterY);
        else
            above=y>senseY;
            Vanalytical(above,j)=E0*(y(above)-senseY);
        end
    end
    Vanalytical(fixed)=fixedValue(fixed);

%Spatial error maps
    errV=abs(Vnumerical-Vanalytical); errV(fixed)=NaN;
        m=find(saveIdx==k,1);
        if ~isempty(m)
            VnumSave{m}=Vnumerical; VanaSave{m}=Vanalytical; errVSave{m}=errV;
            ExSave{m}=Ex; EySave{m}=Ey; shBounds(m,:)=[shL shR];
        end
end

%Numerical and analytical dQ/dT
Qdiff=Q1-Q2;
QdiffAna=Q1ana-Q2ana;
I1=gradient(Q1,time); 
I2=gradient(Q2,time); 
Idiff=gradient(Qdiff,time);
I1ana=gradient(Q1ana,time); 
I2ana=gradient(Q2ana,time);
IdiffAna=gradient(QdiffAna,time);
VoutNumerical=-Rf*Idiff; 
VoutAnalytical=-Rf*IdiffAna;
